# Replace password/owner placeholders locally. Percent-encode special characters in credentials.
# The database must be recruiter_bot. URL query parameters are not supported.
DATABASE_URL=postgresql://recruiter_bot_app:YOUR_URL_ENCODED_PASSWORD@127.0.0.1:5432/recruiter_bot
PORT=3000
NODE_ENV=development

# Offline migrations/seeds/verification only: use a separate database owner login.
# Keep DATABASE_URL above on recruiter_bot_app. Never commit real credentials.
ADMIN_DATABASE_URL=postgresql://YOUR_DB_OWNER:YOUR_URL_ENCODED_PASSWORD@127.0.0.1:5432/recruiter_bot

# Optional for real failure/constraint tests: explicitly disposable, initially empty DB.
TEST_ADMIN_DATABASE_URL=postgresql://YOUR_DB_OWNER:YOUR_URL_ENCODED_PASSWORD@127.0.0.1:5432/recruiter_bot_phase05_test

# Independent Section B Part 2 offline commands only. Never target recruiter_bot.
# Create sql_detective and restrict Bot CONNECT as documented in the backend README.
DETECTIVE_DATABASE_URL=postgresql://YOUR_DB_OWNER:YOUR_URL_ENCODED_PASSWORD@127.0.0.1:5432/sql_detective
